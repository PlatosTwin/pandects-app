  created_at datetime [not null, default: `utc_timestamp()`, note: 'Row creation time (UTC).']
  updated_at datetime [not null, default: `utc_timestamp()`, note: 'Row last-update time (UTC).']

  indexes {
    (agreement_uuid, side, position) [pk]
    counsel_id [name: 'idx_agreement_counsel_counsel_id']
    (side, counsel_id) [name: 'idx_agreement_counsel_side_counsel_id']
  }

  Note: 'Law firms advising each side of each agreement, in the order they were listed. Join through `counsel` for canonical firm names.'
}

