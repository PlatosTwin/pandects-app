  count_agreements bigint(20) [not null, default: 0, note: 'Number of agreements in this bucket.']
  count_pages bigint(20) [not null, default: 0, note: 'Number of source-document pages across those agreements.']
  count_sections bigint(20) [not null, default: 0, note: 'Number of sections across those agreements.']
  count_distinct_acquirer bigint(20) [not null, default: 0, note: 'Distinct acquirer names in this bucket.']
  count_distinct_target bigint(20) [not null, default: 0, note: 'Distinct target names in this bucket.']
  sum_transaction_value_total decimal(18,2) [not null, default: 0.00, note: 'Sum of total transaction values, in USD.']
  count_verified bigint(20) [not null, default: 0, note: 'Number of verified agreements in this bucket.']

  Note: 'Pre-aggregated corpus statistics: one row per observed combination of filing year, form type, exhibit type, party types, deal type, attitude, and purpose, with agreement/page/section counts and total deal value.'
}

Table agreement_overview_summary {
  singleton_key tinyint(4) [pk, not null, note: 'Always 1; enforces the single row.']
  metadata_coverage_pct decimal(5,1) [note: 'Share of eligible agreements with extracted deal metadata.']
  taxonomy_coverage_pct decimal(5,1) [note: 'Share of eligible sections with taxonomy labels.']
  latest_filing_date date [note: 'Most recent `agreements.filing_date` in the corpus.']
  metadata_covered_agreements bigint(20) [note: 'Number of agreements with extracted deal metadata.']
  taxonomy_covered_sections bigint(20) [note: 'Number of sections with taxonomy labels.']

  Note: 'Single-row headline statistics for the data overview page.'
}

Table agreement_index_summary {
  agreement_uuid char(36) [pk, not null, note: 'Primary key; the agreement.']
  year int(11) [note: 'Filing year.']
  target varchar(1024) [note: 'Target company name.']
  acquirer varchar(1024) [note: 'Acquirer company name.']
  verified tinyint(1) [not null, note: '1 if the agreement is verified.']

  indexes {
    acquirer [name: 'idx_agreement_index_acquirer']
    target [name: 'idx_agreement_index_target']
    (year, agreement_uuid) [name: 'idx_agreement_index_year']
  }

  Note: 'One row per public agreement, powering the agreement browse/index pages.'
}

Table agreement_filter_option_summary {
  field_name varchar(64) [not null, note: 'Which filter the option belongs to: targets, acquirers, target_industries, acquirer_industries, target_counsels, or acquirer_counsels.']
  option_value varchar(1024) [not null, note: 'The filterable value.']
  agreement_count bigint(20) [not null, note: 'Number of agreements matching this option.']

  indexes {
    (field_name, option_value) [name: 'idx_filter_option_lookup']
  }

  Note: 'Distinct filter options offered by the search UI, with the number of agreements each matches.'
}

Table agreement_metadata_field_coverage_summary {
  field_name varchar(64) [pk, not null, note: 'Primary key; the `agreements` metadata column being measured.']
  label varchar(128) [not null, note: 'Display label for the field.']
  ingested_eligible_agreements bigint(20) [not null, note: 'Ingested agreements eligible for this field.']
  ingested_covered_agreements bigint(20) [not null, note: 'Ingested agreements with the field populated.']
  ingested_coverage_pct decimal(5,1) [note: 'Coverage percentage over ingested agreements.']
  processed_eligible_agreements bigint(20) [not null, note: 'Fully processed agreements eligible for this field.']
  processed_covered_agreements bigint(20) [not null, note: 'Fully processed agreements with the field populated.']
  processed_coverage_pct decimal(5,1) [note: 'Coverage percentage over fully processed agreements.']
  note text [not null, note: 'Caveats about how coverage is measured for this field.']

  Note: 'Extraction coverage per deal-metadata field: how many agreements are eligible for the field and how many have it populated, over all ingested agreements and over fully processed agreements.'
}

Table agreement_status_summary {
  year int(11) [not null, note: 'Filing year.']
  color varchar(16) [not null, note: 'Display bucket for the stage (gray, green, or red).']
  current_stage varchar(32) [not null, note: 'Pipeline stage (e.g. 1_pre_processing, 3_xml, processed).']
  count int(11) [not null, note: 'Number of agreements at this stage for this year.']

  indexes {
    (year, color, current_stage) [pk]
  }

  Note: 'Pipeline progress counts by filing year: how many agreements sit at each processing stage.'
}

Table agreement_deal_type_summary {
  year int(11) [not null, note: 'Filing year.']
  deal_type varchar(64) [not null, note: 'Transaction structure.']
  count bigint(20) [not null, note: 'Number of agreements.']

  indexes {
    (year, deal_type) [pk]
  }

  Note: 'Deal counts by filing year and transaction structure.'
}

Table agreement_target_industry_summary {
  year int(11) [not null, note: 'Filing year.']
  industry varchar(255) [not null, note: 'Target industry label.']
  deal_count bigint(20) [not null, note: 'Number of agreements.']
  total_transaction_value decimal(24,2) [not null, note: 'Sum of total transaction values, in USD.']

  indexes {
    (year, industry) [pk]
  }

  Note: 'Deal count and total transaction value by filing year and target industry.'
}

Table agreement_industry_pairing_summary {
  target_industry varchar(255) [not null, note: 'Target industry label.']
  acquirer_industry varchar(255) [not null, note: 'Acquirer industry label.']
  deal_count bigint(20) [not null, note: 'Number of agreements.']
  total_transaction_value decimal(24,2) [not null, note: 'Sum of total transaction values, in USD.']

  indexes {
    (target_industry, acquirer_industry) [pk]
  }

  Note: 'Deal count and total transaction value for each (target industry, acquirer industry) pairing.'
}

Table agreement_ownership_mix_summary {
  year int(11) [not null, note: 'Filing year.']
  target_bucket varchar(32) [not null, note: 'Target ownership bucket (public or private).']
  deal_count bigint(20) [not null, note: 'Number of agreements.']
  total_transaction_value decimal(24,2) [not null, note: 'Sum of total transaction values, in USD.']

  indexes {
    (year, target_bucket) [pk]
  }

  Note: 'Deal count and total transaction value by filing year and target ownership bucket.'
}

Table agreement_ownership_deal_size_summary {
  year int(11) [not null, note: 'Filing year.']
  target_bucket varchar(32) [not null, note: 'Target ownership bucket (public or private).']
  deal_count bigint(20) [not null, note: 'Number of agreements.']
  p25_transaction_value decimal(24,2) [note: '25th-percentile total transaction value, in USD.']
  median_transaction_value decimal(24,2) [note: 'Median total transaction value, in USD.']
  p75_transaction_value decimal(24,2) [note: '75th-percentile total transaction value, in USD.']

  indexes {
    (year, target_bucket) [pk]
  }

  Note: 'Transaction-value quartiles by filing year and target ownership bucket.'
}

Table agreement_buyer_type_matrix_summary {
  target_bucket varchar(32) [not null, note: 'Target ownership bucket (public or private).']
  buyer_bucket varchar(32) [not null, note: 'Buyer type: private_equity, private_strategic, public_buyer, or other.']
  deal_count bigint(20) [not null, note: 'Number of agreements.']
  median_transaction_value decimal(24,2) [note: 'Median total transaction value, in USD.']

  indexes {
    (target_bucket, buyer_bucket) [pk]
  }

  Note: 'Deal count and median transaction value for each target ownership bucket x buyer type cell.'
}

Table agreement_counsel_leaderboard_summary {
  side varchar(16) [not null, note: 'buy_side or sell_side.']
  counsel_key varchar(255) [not null, note: 'Normalized firm key (composite PK with `side` and `year`).']
  counsel varchar(255) [not null, note: 'Display name of the firm.']
  year int(11) [not null, note: 'Filing year.']
  deal_count bigint(20) [not null, note: 'Number of deals the firm advised on.']
  total_transaction_value decimal(24,2) [not null, note: 'Sum of total transaction values, in USD.']

  indexes {
    (side, counsel_key, year) [pk]
    (side, year) [name: 'idx_counsel_leaderboard_side_year']
  }

  Note: 'Counsel league table: deal count and total transaction value per law firm, by side and filing year.'
}

TableGroup agreements_and_documents {
  agreements
  xml
  sections
  clauses
}

TableGroup section_taxonomy {
  taxonomy_l1
  taxonomy_l2
  taxonomy_l3
}

TableGroup clause_taxonomy_tax_module {
  tax_clause_taxonomy_l1
  tax_clause_taxonomy_l2
  tax_clause_taxonomy_l3
  tax_clause_assignments
}

TableGroup search_denormalizations {
  latest_sections_search
  latest_sections_search_standard_ids
}

TableGroup counsel {
  counsel
  agreement_counsel
}

TableGroup reference_data {
  naics_sectors
  naics_sub_sectors
}

TableGroup analytics_summaries {
  summary_data
  agreement_overview_summary
  agreement_index_summary
  agreement_filter_option_summary
  agreement_metadata_field_coverage_summary
  agreement_status_summary
  agreement_deal_type_summary
  agreement_target_industry_summary
  agreement_industry_pairing_summary
  agreement_ownership_mix_summary
  agreement_ownership_deal_size_summary
  agreement_buyer_type_matrix_summary
  agreement_counsel_leaderboard_summary
}

Ref: agreement_counsel.agreement_uuid > agreements.agreement_uuid
Ref: agreement_counsel.counsel_id > counsel.counsel_id
Ref: naics_sub_sectors.sector_code > naics_sectors.sector_code
Ref: sections.agreement_uuid > agreements.agreement_uuid
Ref: clauses.agreement_uuid > agreements.agreement_uuid
Ref: clauses.section_uuid > sections.section_uuid
Ref: xml.agreement_uuid > agreements.agreement_uuid
Ref: taxonomy_l2.parent_id > taxonomy_l1.standard_id
Ref: taxonomy_l3.parent_id > taxonomy_l2.standard_id
Ref: tax_clause_taxonomy_l2.parent_id > tax_clause_taxonomy_l1.standard_id
Ref: tax_clause_taxonomy_l3.parent_id > tax_clause_taxonomy_l2.standard_id
Ref: tax_clause_assignments.clause_uuid > clauses.clause_uuid
Ref: tax_clause_assignments.standard_id > tax_clause_taxonomy_l3.standard_id
Ref: latest_sections_search.section_uuid - sections.section_uuid
Ref: latest_sections_search.agreement_uuid > agreements.agreement_uuid
Ref: latest_sections_search_standard_ids.section_uuid > latest_sections_search.section_uuid
Ref: latest_sections_search_standard_ids.standard_id > taxonomy_l3.standard_id
Ref: agreement_index_summary.agreement_uuid - agreements.agreement_uuid
