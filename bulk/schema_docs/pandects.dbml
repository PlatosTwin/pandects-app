  updated_date datetime [default: `utc_timestamp()`, note: 'When the row was last updated (UTC).']
  gated tinyint(1) [note: '1 holds the agreement out of public app/API surfaces until it is verified. Gated, unverified agreements are excluded from API results.']
  validation_priority double [note: 'Score used to order agreements in the internal validation queue.']
  metadata_uncited_fields longtext [note: 'JSON list of extracted metadata fields that lack a supporting citation.']
  target_counsel longtext [note: 'JSON array of law-firm names advising the target, as extracted from the agreement. Normalized form lives in `counsel` / `agreement_counsel`.']
  acquirer_counsel longtext [note: 'JSON array of law-firm names advising the acquirer, as extracted from the agreement. Normalized form lives in `counsel` / `agreement_counsel`.']
